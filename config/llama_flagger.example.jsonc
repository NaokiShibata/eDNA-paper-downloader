{
  // Required
  "scope": "environmental DNA/RNA papers for ecology and monitoring; exclude unrelated genomics or microbiome-only studies",
  "model_path": "/path/to/model.gguf",

  // Output
  "out_csv": "results/flagged.csv",

  // Optional: llama.cpp + model settings
  "llama_bin": "/path/to/llama-cli",
  // model_profile is optional when explicit overrides are set; if omitted, inferred from model_path.
  "model_profile": "gpt-oss",
  // Profile defaults:
  // - gpt-oss: sampling_temperature=0.05, ctx_size=8192
  // - gemma:   sampling_temperature=0.05, ctx_size=4096
  // - other:   sampling_temperature=0.1, ctx_size=unchanged
  // Overrides (set to null to use profile defaults).
  "ctx_size": null,
  "sampling_temperature": null,
  "threads": 8,
  // Extra llama-cli args (example: "--no-conversation")
  "llama_args": null,
  // Example preset: GLM-4.7-Flash (llama.cpp)
  // "model_profile": null,
  // "threads": -1,
  // "ctx_size": 16384,
  // "sampling_temperature": 1.0,
  // "llama_args": "--top-p 0.95 --min-p 0.01 --fit on --seed 3407 --jinja",
  "reuse_process": true,
  "batch_size": 500,
  "batch_index": 0,
  "limit": null,
  "resume": true,
  "dry_run": false,
  "max_tokens": 256,
  "timeout": 300.0,

  // Optional: relevance hints
  "include_hint": "eDNA/eRNA sampling, detection, monitoring, metabarcoding, pathogen surveillance",
  "exclude_hint": "microbiome-only, unrelated CRISPR tool development, pure genomics without environmental DNA"
}
